        {
          "step": 2,
          "title": "Deploying Vertical Solar Array",
          "instruction": "Open the Build Menu [B] and select the Vertical Solar Array Technology (VSAT). Place it on an elevated plateau tile.",
          "highlightElement": "btn-build-menu"
