        {
          "step": 3,
          "title": "Energy Storage for Shadow Dips",
          "instruction": "Sunlight dips when distant peaks cast shadows. Place a Li-Ion Battery Bank next to your solar array to buffer energy.",
          "highlightElement": "module-battery"
        }
